{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forbidden Series Setup",
  "version": "0.1.0",
  "identifier": "com.forbiddenseries.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Instalar Forbidden Series",
        "width": 720,
        "height": 440,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0D0D0D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
