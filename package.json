{
  "name": "akashic-launcher",
  "private": true,
  "version": "0.1.0",
  "description": "Akashic Launcher — UI/UX launcher para servidor Minecraft 1.7.10 Modded",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n vite,electron -c magenta,cyan \"vite --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/league-gothic": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wait-on": "^9.5.1"
  },
  "type": "module"
}
